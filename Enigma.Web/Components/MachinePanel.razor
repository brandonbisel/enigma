@* The machine itself: what an operator faced. Windows above, lamps in the middle,
   keys below. It holds no message and no cipher logic — the lamp it lights is
   handed to it, so the panel and the message pane cannot tell different stories. *@

<div class="panel" tabindex="0" data-testid="panel"
     @onkeydown="PhysicalDown" @onkeyup="PhysicalUp" @onblur="Release">

    <header class="plate">
        <span class="plate-name">@Session.KeySheet.Name</span>
        <span class="plate-parts">
            @Session.Machine.Reflector.Name &middot;
            @string.Join(' ', Session.Machine.Rotors.Select(rotor => rotor.Name))
        </span>
    </header>

    <RotorWindows Session="Session" />

    <LampBoard Alphabet="Session.Alphabet" Lit="Lit" />

    <Keyboard Alphabet="Session.Alphabet" Held="_held" OnDown="Press" OnUp="Release" />
</div>

@code {
    [Parameter, EditorRequired] public required EnigmaSession Session { get; set; }

    /// <summary>The lamp alight, decided by whoever is working the machine.</summary>
    [Parameter] public char? Lit { get; set; }

    [Parameter] public EventCallback<char> OnKeyed { get; set; }

    [Parameter] public EventCallback OnReleased { get; set; }

    private char? _held;

    private async Task Press(char key)
    {
        // One key at a time: the real keyboard locks out a second while the first
        // is down, and letting two through would step the wheels twice.
        if (_held is not null)
        {
            return;
        }

        _held = key;

        await OnKeyed.InvokeAsync(key);
    }

    private async Task Release()
    {
        if (_held is null)
        {
            return;
        }

        _held = null;

        await OnReleased.InvokeAsync();
    }

    private Task PhysicalDown(KeyboardEventArgs args)
    {
        // Held keys repeat, and a repeat is not a fresh press of anything.
        if (args.Repeat || args.Key.Length != 1)
        {
            return Task.CompletedTask;
        }

        return Press(args.Key[0]);
    }

    private Task PhysicalUp(KeyboardEventArgs args) =>
        args.Key.Length == 1 && Matches(args.Key[0]) ? Release() : Task.CompletedTask;

    // The key that goes up is the one that went down, whatever case it was typed in.
    private bool Matches(char key) =>
        _held is { } held &&
        (key == held || char.ToUpperInvariant(key) == char.ToUpperInvariant(held));
}

@* The indicator procedure. The key sheet fixed everything for the day except
   where the rotors began: the sender chose that himself and told the receiver, and
   the two services told him in quite different ways.

   The Army enciphered its message key at the ground setting and sent the result in
   clear. The Navy sent nothing in clear: two trigrams out of the Kenngruppenbuch,
   one naming the key and one giving the message key, both padded and then hidden
   under a double-letter conversion table. *@

<section class="indicator" data-testid="indicator">
    <h2>Spruchschlüssel <span class="gloss">the message key</span></h2>

    <div class="fields">
        <label>Procedure
            <select data-testid="procedure" value="@Mode" @onchange="Choose">
                <option value="@IndicatorMode.None">none — start at the Grundstellung (ground setting)</option>
                <option value="@IndicatorMode.Sending">Heer / Luftwaffe, sending — choose a message key</option>
                <option value="@IndicatorMode.Receiving">Heer / Luftwaffe, receiving — work back from an indicator</option>
                <option value="@IndicatorMode.NavalSending">Kriegsmarine, sending — choose two Kenngruppen</option>
                <option value="@IndicatorMode.NavalReceiving">Kriegsmarine, receiving — work back from eight letters</option>
            </select>
        </label>

        @if (Mode == IndicatorMode.Sending)
        {
            <label>Message key
                <input data-testid="message-key" value="@MessageKey" @onchange="Keyed" />
            </label>
        }

        @if (Mode == IndicatorMode.Receiving)
        {
            <label>Indicator
                <input data-testid="indicator-sent" value="@Indicator" @onchange="Sent" />
            </label>
        }

        @if (Mode == IndicatorMode.NavalSending)
        {
            <label>Schlüsselkenngruppe <span class="gloss">names the key in force</span>
                <input data-testid="key-group" maxlength="3" value="@KeyGroup" @onchange="KeyGrouped" />
            </label>

            <label>Verfahrenkenngruppe <span class="gloss">becomes the message key</span>
                <input data-testid="message-group" maxlength="3" value="@MessageGroup" @onchange="MessageGrouped" />
            </label>

            <label>Füllbuchstaben <span class="gloss">padding, first and last</span>
                <span class="fillers">
                    <input data-testid="first-filler" maxlength="1" value="@FirstFiller" @onchange="FirstFilled" />
                    <input data-testid="last-filler" maxlength="1" value="@LastFiller" @onchange="LastFilled" />
                </span>
            </label>
        }

        @if (Mode == IndicatorMode.NavalReceiving)
        {
            <label>Indicator <span class="gloss">the eight letters sent</span>
                <input data-testid="indicator-sent" maxlength="9" value="@Indicator" @onchange="Sent" />
            </label>
        }
    </div>

    @if (Mode == IndicatorMode.Sending)
    {
        <label class="doubled">
            <input type="checkbox" data-testid="doubled" checked="@Doubled" @onchange="Doubling" />
            Sent twice, as it was until 1938
        </label>
    }

    @if (Mode.IsNaval())
    {
        <BigramTablePicker Kennziffer="Kennziffer"
                           Monatstag="Monatstag"
                           Choice="Choice"
                           OnKennziffer="OnKennziffer"
                           OnMonatstag="OnMonatstag"
                           OnTafel="OnTafel" />
    }

    @if (Mode != IndicatorMode.None)
    {
        @if (Error is not null)
        {
            <p class="error" data-testid="indicator-error">@Error</p>
        }
        else if (Result is { IsNaval: true })
        {
            <p class="worked" data-testid="worked">
                Ground setting <span>@Result.GroundSetting</span>,
                Schlüsselkenngruppe <span>@Result.KeyGroup</span>,
                Verfahrenkenngruppe <span>@Result.MessageGroup</span>,
                sent as <span>@Result.Indicator</span>,
                rotors set to <span>@Result.MessageKey</span>
            </p>
        }
        else if (Result is not null)
        {
            <p class="worked" data-testid="worked">
                Ground setting <span>@Result.GroundSetting</span>,
                indicator <span>@Result.Indicator</span>,
                rotors set to <span>@Result.MessageKey</span>
            </p>
        }
    }
</section>

@code {
    [Parameter] public IndicatorMode Mode { get; set; }

    [Parameter] public string MessageKey { get; set; } = string.Empty;

    [Parameter] public string Indicator { get; set; } = string.Empty;

    [Parameter] public bool Doubled { get; set; }

    [Parameter] public string KeyGroup { get; set; } = string.Empty;

    [Parameter] public string MessageGroup { get; set; } = string.Empty;

    [Parameter] public char FirstFiller { get; set; } = 'X';

    [Parameter] public char LastFiller { get; set; } = 'X';

    [Parameter] public int Kennziffer { get; set; }

    [Parameter] public int Monatstag { get; set; } = 1;

    [Parameter] public TableChoice Choice { get; set; } = BigramTableChoice.From(0, 1, 'A');

    /// <summary>What the procedure worked out, when it worked.</summary>
    [Parameter] public IndicatorResult? Result { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<IndicatorMode> OnMode { get; set; }

    [Parameter] public EventCallback<string> OnMessageKey { get; set; }

    [Parameter] public EventCallback<string> OnIndicator { get; set; }

    [Parameter] public EventCallback<bool> OnDoubled { get; set; }

    [Parameter] public EventCallback<string> OnKeyGroup { get; set; }

    [Parameter] public EventCallback<string> OnMessageGroup { get; set; }

    [Parameter] public EventCallback<char> OnFirstFiller { get; set; }

    [Parameter] public EventCallback<char> OnLastFiller { get; set; }

    [Parameter] public EventCallback<int> OnKennziffer { get; set; }

    [Parameter] public EventCallback<int> OnMonatstag { get; set; }

    [Parameter] public EventCallback<char> OnTafel { get; set; }

    private Task Choose(ChangeEventArgs args) =>
        Enum.TryParse<IndicatorMode>(args.Value?.ToString(), out var mode)
            ? OnMode.InvokeAsync(mode)
            : Task.CompletedTask;

    private Task Keyed(ChangeEventArgs args) => OnMessageKey.InvokeAsync(Text(args));

    private Task Sent(ChangeEventArgs args) => OnIndicator.InvokeAsync(Text(args));

    private Task Doubling(ChangeEventArgs args) => OnDoubled.InvokeAsync(args.Value is true);

    private Task KeyGrouped(ChangeEventArgs args) => OnKeyGroup.InvokeAsync(Text(args));

    private Task MessageGrouped(ChangeEventArgs args) => OnMessageGroup.InvokeAsync(Text(args));

    private Task FirstFilled(ChangeEventArgs args) => Filled(OnFirstFiller, args);

    private Task LastFilled(ChangeEventArgs args) => Filled(OnLastFiller, args);

    // An empty box would pad with nothing at all, which is not a thing the
    // procedure can do, so the letter stands until it is replaced.
    private static Task Filled(EventCallback<char> callback, ChangeEventArgs args) =>
        Text(args) is { Length: > 0 } filler
            ? callback.InvokeAsync(char.ToUpperInvariant(filler[0]))
            : Task.CompletedTask;

    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;
}

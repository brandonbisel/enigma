@page "/"
@inject IKeySheetCatalogue KeySheets
@inject IEnigmaMachineFactory Factory
@inject IIndicatorProcedure Procedure
@inject INavalIndicatorProcedure NavalProcedure

<PageTitle>Enigma</PageTitle>

<h1>Enigma</h1>

<label class="sheet-picker">
    Key sheet
    <select data-testid="sheet" value="@_name" @onchange="Choose">
        @foreach (var name in KeySheets.Names)
        {
            <option value="@name">@KeySheets.All[name].Name</option>
        }
    </select>
</label>

@if (_error is not null)
{
    <p class="error" data-testid="error">@_error</p>
}

@if (_session is not null)
{
    <MachinePanel Session="_session" Lit="_lit" OnKeyed="Keyed" OnReleased="Released" @key="_generation" />

    <SignalPath Alphabet="_session.Alphabet"
                Trace="_trace"
                Watching="_watching"
                OnWatching="Watching" />

    @* String parameters take the attribute literally unless it is an expression,
       which is why these two carry an @ and the others do not. *@
    <MessagePanes Plaintext="@_message"
                  Ciphertext="@Ciphertext"
                  Prepare="_prepare"
                  Groups="_groups"
                  OnPlaintext="Wrote"
                  OnPrepare="Preparing"
                  OnGroups="Grouping" />

    <IndicatorPanel Mode="_mode"
                    MessageKey="@_messageKey"
                    Indicator="@_indicator"
                    Doubled="_doubled"
                    Result="_keying"
                    Error="@_keying?.Error"
                    OnMode="Procedure_Mode"
                    OnMessageKey="Procedure_MessageKey"
                    OnIndicator="Procedure_Indicator"
                    OnDoubled="Procedure_Doubled"
                    KeyGroup="@_keyGroup"
                    MessageGroup="@_messageGroup"
                    FirstFiller="_firstFiller"
                    LastFiller="_lastFiller"
                    Kennziffer="_kennziffer"
                    Monatstag="_monatstag"
                    Choice="Chosen"
                    OnKeyGroup="Procedure_KeyGroup"
                    OnMessageGroup="Procedure_MessageGroup"
                    OnFirstFiller="Procedure_FirstFiller"
                    OnLastFiller="Procedure_LastFiller"
                    OnSet="Procedure_Set"
                    OnKennziffer="Procedure_Kennziffer"
                    OnMonatstag="Procedure_Monatstag"
                    OnTafel="Procedure_Tafel" />

    <KeySheetEditor Sheet="_sheet"
                    ShowsReflectorSetting="_session.ReflectorPosition is not null"
                    OnChanged="Rekey" />

    @if (_session.HasPlugBoard)
    {
        <PlugBoardPanel Alphabet="_session.Alphabet"
                        Cables="_session.Cables().ToList()"
                        OnPatch="Patch"
                        OnUnpatch="Unpatch" />
    }
}

@code {
    private string _name = "default";
    private KeySheet _sheet = new();
    private EnigmaSession? _session;
    private string? _error;
    private int _generation;

    // The message is held here rather than in either view, so the keyboard and the
    // pane are two ways of entering one message rather than two messages.
    private string _message = string.Empty;
    private string _cipher = string.Empty;
    private bool _prepare;
    private int? _groups;
    private char? _lit;

    // Following the current is what makes the machine assemble a trace at all, so
    // it is asked for rather than left on: a long message would otherwise build one
    // per character for nobody.
    private bool _watching;
    private TranslationTrace? _trace;

    // The indicator procedure decides where the rotors start. Without one that is
    // simply what the key sheet says.
    private IndicatorMode _mode;
    private string _messageKey = string.Empty;
    private string _indicator = string.Empty;
    private bool _doubled;
    private IndicatorResult? _keying;

    // The naval procedure. Two trigrams out of the Kenngruppenbuch, the fillers that
    // pad them, and which conversion table hides the result.
    private string _keyGroup = string.Empty;
    private string _messageGroup = string.Empty;
    private char _firstFiller = 'X';
    private char _lastFiller = 'X';
    private BigramTableSet _set = BigramTableSet.Quelle;
    private int _kennziffer;
    private int _monatstag = 1;
    private char _tafel = 'A';

    /// <summary>
    /// Which table is in force. With a Kennziffer chosen the Tauschtafelplan decides
    /// it and the operator does not, which is how it worked. The rule is shared with
    /// the command line rather than written out twice.
    /// </summary>
    private TableChoice Chosen => BigramTableChoice.From(_set, _kennziffer, _monatstag, _tafel);

    private string Ciphertext => _groups is { } size ? MessageText.InGroups(_cipher, size) : _cipher;

    protected override void OnInitialized() => Choose(_name);

    private void Choose(ChangeEventArgs args) => Choose(args.Value?.ToString() ?? _name);

    private void Choose(string name)
    {
        _name = name;

        if (!KeySheets.TryGet(name, out var sheet))
        {
            (_session, _error) = (null, $"No key sheet called '{name}'.");

            return;
        }

        Rekey(sheet.Copy());
    }

    private void Rekey(KeySheet sheet)
    {
        _sheet = sheet;

        var keyed = EnigmaSession.Open(Factory, Keyed(sheet));

        _error = keyed.Error;

        // A machine that cannot be built leaves the last working one in place: the
        // operator is midway through setting up, not holding a broken machine.
        if (keyed.Session is null)
        {
            return;
        }

        _session = keyed.Session;
        _generation++;

        // A new machine, so the watcher has to be put back on it.
        if (_watching)
        {
            _session.Traced += Traced;
        }

        // The message survives a change of settings, which is the point of being
        // able to change them: the same text, keyed a different way.
        Retype();
    }

    /// <summary>
    /// A key goes down. The wheels turn and a lamp lights, and both the message and
    /// the ciphertext grow by one, so the incremental path and
    /// <see cref="Retype"/> can never disagree: only keys the machine has are kept.
    /// </summary>
    private void Keyed(char key)
    {
        if (_session?.Press(key) is not { } lamp)
        {
            return;
        }

        _message += key;
        _cipher += lamp;
        _lit = lamp;
    }

    private void Released() => _lit = null;

    /// <summary>
    /// Where the rotors start. With a procedure in use the sheet's positions are
    /// the ground setting and the machine is keyed at the message key instead; a
    /// procedure that will not work leaves the machine at the ground setting, so
    /// the operator is not left without one while they correct it.
    /// </summary>
    private KeySheet Keyed(KeySheet daily)
    {
        _keying = _mode switch
        {
            IndicatorMode.Sending => MessageKeying.Send(Procedure, daily, _messageKey, _doubled),
            IndicatorMode.Receiving => MessageKeying.Receive(Procedure, daily, _indicator),
            IndicatorMode.NavalSending => Naval(daily, table => MessageKeying.SendNaval(
                NavalProcedure, daily, table, _keyGroup, _messageGroup, _firstFiller, _lastFiller)),
            IndicatorMode.NavalReceiving => Naval(daily, table => MessageKeying.ReceiveNaval(
                NavalProcedure, daily, table, _indicator)),
            _ => null
        };

        return _keying?.Sheet ?? daily;
    }

    /// <summary>
    /// The naval procedure cannot run without a table, and one of the nine the set
    /// ran to has never been recovered. A day that calls for it is a real answer,
    /// not a fault, so it is reported as one rather than throwing.
    /// </summary>
    private IndicatorResult Naval(KeySheet daily, Func<BigramTable, IndicatorResult> keying) =>
        Chosen is { Table: { } table }
            ? keying(table)
            : new IndicatorResult(null, null, null, null, Chosen.Missing);

    private void Procedure_KeyGroup(string keyGroup)
    {
        _keyGroup = keyGroup;

        Rekey(_sheet);
    }

    private void Procedure_MessageGroup(string messageGroup)
    {
        _messageGroup = messageGroup;

        Rekey(_sheet);
    }

    private void Procedure_FirstFiller(char filler)
    {
        _firstFiller = filler;

        Rekey(_sheet);
    }

    private void Procedure_LastFiller(char filler)
    {
        _lastFiller = filler;

        Rekey(_sheet);
    }

    /// <summary>
    /// Changing booklet changes what the other two controls can mean: the plans are
    /// not the same length, and the sets do not hold the same letters. Anything the
    /// new set cannot honour falls back rather than pointing at nothing.
    /// </summary>
    private void Procedure_Set(string name)
    {
        if (!BigramTableSet.All.TryGetValue(name, out var set))
        {
            return;
        }

        _set = set;

        if (_kennziffer > _set.Plan.Columns)
        {
            _kennziffer = 0;
        }

        if (!_set.Tables.ContainsKey(_tafel))
        {
            _tafel = _set.Tables.Keys.First();
        }

        Rekey(_sheet);
    }

    private void Procedure_Kennziffer(int kennziffer)
    {
        _kennziffer = kennziffer;

        Rekey(_sheet);
    }

    private void Procedure_Monatstag(int monatstag)
    {
        _monatstag = Math.Clamp(monatstag, 1, 31);

        Rekey(_sheet);
    }

    private void Procedure_Tafel(char tafel)
    {
        _tafel = tafel;

        Rekey(_sheet);
    }

    private void Procedure_Mode(IndicatorMode mode)
    {
        _mode = mode;

        Rekey(_sheet);
    }

    private void Procedure_MessageKey(string messageKey)
    {
        _messageKey = messageKey;

        Rekey(_sheet);
    }

    private void Procedure_Indicator(string indicator)
    {
        _indicator = indicator;

        Rekey(_sheet);
    }

    private void Procedure_Doubled(bool doubled)
    {
        _doubled = doubled;

        Rekey(_sheet);
    }

    private void Watching(bool watching)
    {
        _watching = watching;

        if (_session is null)
        {
            return;
        }

        if (watching)
        {
            _session.Traced += Traced;

            // Keying the message again fills the view in straight away, rather than
            // leaving it blank until the next key goes down.
            Retype();

            return;
        }

        // Not cleared here: Retype is the one place that forgets a trace, and every
        // way back to showing one goes through it.
        _session.Traced -= Traced;
    }

    private void Traced(TranslationTrace trace) => _trace = trace;

    private void Wrote(string text)
    {
        _message = text;

        Retype();
    }

    private void Preparing(bool prepare)
    {
        _prepare = prepare;

        Retype();
    }

    // Grouping is how the ciphertext is written out, not how it was enciphered,
    // so it changes nothing about the machine.
    private void Grouping(int? groups) => _groups = groups;

    private void Retype()
    {
        if (_session is null)
        {
            return;
        }

        _session.Reset();

        // Cleared before, not after: the watcher fills it in again as the message
        // is keyed, so an empty message correctly leaves nothing to show rather
        // than a keypress that is no longer part of it.
        _trace = null;

        _cipher = _session.Type(_prepare ? MessageText.Prepare(_message) : _message);
        _lit = null;
    }

    private void Patch((char From, char To) cable) =>
        Rekey(WithCables(Cables().Append($"{cable.From}{cable.To}")));

    private void Unpatch((char From, char To) cable) =>
        Rekey(WithCables(Cables().Where(pair => !Joins(pair, cable))));

    private static bool Joins(string pair, (char From, char To) cable) =>
        pair.Contains(cable.From) || pair.Contains(cable.To);

    private IEnumerable<string> Cables() =>
        (_sheet.Plugboard ?? string.Empty)
            .Split([' ', '\t', ',', '-', '/'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // The order is kept because an Uhr numbers its cables by it.
    private KeySheet WithCables(IEnumerable<string> cables)
    {
        var sheet = _sheet.Copy();

        sheet.Plugboard = string.Join(' ', cables);

        return sheet;
    }
}
